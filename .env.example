# heap-lab per-user overrides. Copy to .env, then: direnv allow
# Any key in config/heap-lab.env can be set here.
#
# HEAP_REPO=$HOME/src/cluster-config-upgrade   # a second checkout to rehearse
# LAB_STAGE=new
# LAB_MEMORY_GREENE=6GiB
#
# batchmate.id clients from console.batchmate.cloud (task oidc):
# LAB_OIDC_KUBECTL_CLIENT_ID=
# LAB_OIDC_ARGOCD_CLIENT_ID=
# LAB_OIDC_ARGOCD_CLIENT_SECRET=
# Admins in Kubernetes and Argo CD: subjects as Argo CD logs them, space-separated
# (sub_… until batchmate.id sends the RC id, then the id). task whoami shows yours.
# LAB_OIDC_ADMINS="sub_0123456789abcdef0123456789abcdef"
