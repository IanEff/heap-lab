# heap-lab: every value the lab uses, in one place.
#
# Committed; no secrets. Per-user overrides go in .env (see .env.example).
# Read by scripts/lib.sh on the Mac. Ansible sees it through the environment
# (inventory/ uses lookup('env', ...)), so don't hardcode these anywhere else.

# The cluster-config checkout under test. k3s.yml, k3s-teardown.yml, the roles
# and scripts/heap-check.sh all run straight from its working tree: whatever
# branch is checked out there is what gets rehearsed.
HEAP_REPO="$HOME/projects/rc/cluster-config"

# What `task up` builds when STAGE isn't given.
#   old  Heap as it stood on 2026-11-16: k3s v1.31 on broome and greene,
#        a standalone v1.36 + Cilium on crosby.
#   new  the end state of the migration, built by HEAP_REPO's k3s.yml.
# Flip the default to new once Heap's Phase 7 is done.
LAB_STAGE=old

# ─── Topology ────────────────────────────────────────────────────────────────
# Three VMs named after the Heap nodes they stand in for. mercer is left out
# by default: it's a second old agent (greene covers that) and a second
# containerd bind mount (crosby covers that). Two servers and one agent keeps
# Heap's etcd arithmetic: lose either server and the API goes.
#
# LAB_MERCER=1 (in .env, before task up) adds mercer as the fourth VM: an old
# agent with the containerd bind mount, in old_agents and, as in cluster-config's
# inventory, k3s_agents. It's for the phases where both clusters run side by
# side (README, drill 3). Snapshots taken with it hold four VMs; flip it only
# together with a rebuild.

LAB_NODES="greene crosby broome"
LAB_MERCER="${LAB_MERCER:-0}"   # or LAB_MERCER=1 task up ...
LAB_CPUS=2
LAB_MEMORY_GREENE=4GiB
LAB_MEMORY_CROSBY=4GiB
LAB_MEMORY_BROOME=4GiB
LAB_MEMORY_MERCER=4GiB
LAB_DISK=30GiB
LAB_DATA_DISK=20GiB      # broome's /data; sdb on Heap
LAB_SWAP_MB=1024         # Heap: 4-8 GB of swap on every node, /swap.img

# ─── Network ─────────────────────────────────────────────────────────────────
# Lima's user-v2 network: one NIC per VM, VMs are L2 neighbours, internet
# through Lima's NAT. That's Heap's shape (one card, one /27), so the role's
# Cilium values run unmodified. Fixed addresses use Heap's last octets. Lima's
# DHCP address stays on eth0 as a secondary, because Lima's ssh needs it.

LAB_SUBNET_PREFIX=192.168.104
LAB_GATEWAY=192.168.104.2
LAB_IP_GREENE=192.168.104.138
LAB_IP_CROSBY=192.168.104.132
LAB_IP_BROOME=192.168.104.133
LAB_IP_MERCER=192.168.104.131
# IPv6 on the same NIC. Heap's nodes share 2602:fb65:0:90::/64 as well as the
# /27. The lab uses a ULA /64 (random global ID, Heap's subnet id 90) with
# Heap's interface IDs, brought up by the same netplan file as the IPv4
# address. No IPv6 router: no RA, no default route, no IPv6 internet.
LAB_IPV6_PREFIX=fdf2:4f9f:1e83:90
LAB_IPV6_GREENE=${LAB_IPV6_PREFIX}::11
LAB_IPV6_CROSBY=${LAB_IPV6_PREFIX}::3
LAB_IPV6_BROOME=${LAB_IPV6_PREFIX}::4
LAB_IPV6_MERCER=${LAB_IPV6_PREFIX}::2
# The new cluster's pod and service ranges (cluster-config's k3s_cluster_cidr
# and k3s_service_cidr), unreachable on every VM: the lab's own instrument.
# Without Cilium a node has no route to the other nodes' pod ranges, so those
# packets take the default route. On Heap the upstream router drops them. Lima's
# NAT instead opens each one as a TCP connection from the Mac, where it hangs,
# and once enough hang no VM's TCP gets out (2026-11-20: 125 SYNs from crosby's
# API server to a pod on greene, every VM's egress dead, crosby unable to pull
# Cilium). Cilium's per-node routes are more specific, so they still win.
LAB_UNREACHABLE_POD_CIDR=10.44.0.0/16
LAB_UNREACHABLE_SERVICE_CIDR=10.45.0.0/16
# Inventory names are <node>.heap-lab, so inventory_hostname_short is the
# Heap node name, and nothing can resolve them outside the lab.
LAB_DOMAIN=heap-lab
# Each node's 6443, forwarded to the Mac's loopback.
LAB_API_PORT_GREENE=16443
LAB_API_PORT_CROSBY=16444
LAB_API_PORT_BROOME=16445
LAB_API_PORT_MERCER=16446

# ─── Old stage ───────────────────────────────────────────────────────────────
# Versions as found on 2026-11-13/16. The new stage's versions come from
# HEAP_REPO's roles/k3s/defaults, which is the thing under test.

OLD_K3S_SERVER=v1.31.2+k3s1      # broome, --flannel-backend=vxlan, sqlite
OLD_K3S_AGENT=v1.31.6+k3s1       # greene, and mercer with LAB_MERCER=1
EXPERIMENT_K3S=v1.36.6+k3s1      # crosby: the standalone cluster-init
EXPERIMENT_CILIUM=1.20.4

# ─── New stage ───────────────────────────────────────────────────────────────
# Stand-ins for what Argo CD will own once the config repo exists (Phase 4).
# R-S2: csi-driver-nfs, StorageClass heap-nfs on broome's /data/k8s.
# Used by scripts/addons.sh only; `task argo` installs it from HEAP_K8S instead.

CSI_NFS_VERSION=4.13.6

# The config repo (Phase 4). Argo CD syncs one of two sources (task argo):
#   lab       heap-k8s/ in this repo: the subset of HEAP_K8S the lab can bring
#             to Healthy, with Heap's values as placeholders and four marked
#             deltas (heap-k8s/README.md).
#   upstream  all of HEAP_K8S at HEAP_K8S_REF, Heap's values swapped, nothing
#             else changed.
LAB_ARGO_SOURCE=lab
# Upstream, for SOURCE=upstream and for task argo-drift. A URL or a local path;
# a local path is read at its committed HEAD of HEAP_K8S_REF.
HEAP_K8S="https://github.com/recursecenter/heap-k8s.git"
HEAP_K8S_REF=main
# The upstream commit heap-k8s/ was copied from. task argo-drift fails once
# upstream has newer commits in the mirrored directories.
HEAP_K8S_MIRRORED=74d7823
# scripts/argo.sh serves the lab's copy of it from broome on this port (the
# lab's own instrument; nothing on Heap listens here).
LAB_GIT_PORT=8418

# ─── Logins ──────────────────────────────────────────────────────────────────
# The real batchmate.id: Chandler's OIDC gateway in front of recurse.com. Not a
# stand-in; the lab logs in exactly as Heap will. The client IDs and Argo CD's
# client secret are per person and go in .env (see .env.example):
#   LAB_OIDC_KUBECTL_CLIENT_ID     public client, redirect http://localhost:8000
#   LAB_OIDC_ARGOCD_CLIENT_ID      confidential, redirect
#   LAB_OIDC_ARGOCD_CLIENT_SECRET    http://localhost:8080/auth/callback
LAB_OIDC_ISSUER=https://batchmate.id
# The idp_issuer batchmate.id sends for recurse.com logins; the k3s role's
# k3s_oidc_rc_issuer. Heap's inventory has the same value.
LAB_OIDC_RC_ISSUER=https://www.recurse.com

UBUNTU_RELEASE=24.04
